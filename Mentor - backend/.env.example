# Backend Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True

# Server settings
HOST=0.0.0.0
PORT=5000

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Data paths (relative to backend folder)
MENTORS_DATA_PATH=data/enhanced_mentors.csv
MENTEES_DATA_PATH=data/enhanced_mentees.csv
MODEL_PATH=models/mentorship_model.pkl

# Firebase Configuration (for Firestore database access)
FIREBASE_PROJECT_ID=edusoul-baeb2
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/

# AI interview evaluation (keep the real key in .env; never commit it)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
