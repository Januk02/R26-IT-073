# Backend Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True

# Server settings
HOST=0.0.0.0
PORT=5000

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Data paths (relative to backend folder)
MENTORS_DATA_PATH=data/enhanced_mentors.csv
MENTEES_DATA_PATH=data/enhanced_mentees.csv
MODEL_PATH=models/mentorship_model.pkl
