rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Chat Rooms Rules
    match /chatRooms/{chatRoomId} {
      allow read: if request.auth != null && 
        (resource.data.participants.studentId == request.auth.uid || 
         resource.data.participants.mentorId == request.auth.uid);
      
      allow create: if request.auth != null && 
        (request.resource.data.participants.studentId == request.auth.uid || 
         request.resource.data.participants.mentorId == request.auth.uid);
      
      allow update: if request.auth != null && 
        (resource.data.participants.studentId == request.auth.uid || 
         resource.data.participants.mentorId == request.auth.uid);
      
      // Messages Subcollection
      match /messages/{messageId} {
        allow read: if request.auth != null && 
          (get(/databases/$(database)/documents/chatRooms/$(chatRoomId)).data.participants.studentId == request.auth.uid || 
           get(/databases/$(database)/documents/chatRooms/$(chatRoomId)).data.participants.mentorId == request.auth.uid);
        
        allow create: if request.auth != null && 
          (get(/databases/$(database)/documents/chatRooms/$(chatRoomId)).data.participants.studentId == request.auth.uid || 
           get(/databases/$(database)/documents/chatRooms/$(chatRoomId)).data.participants.mentorId == request.auth.uid) &&
          request.resource.data.senderId == request.auth.uid;
        
        allow update: if request.auth != null && 
          request.resource.data.senderId == request.auth.uid;
      }
    }
    
    // User Preferences
    match /userChatPreferences/{userId} {
      allow read, write: if request.auth != null && 
        request.auth.uid == userId;
    }
    
    // Existing collections (verifications, cvVerifications)
    match /verifications/{verificationId} {
      allow read: if request.auth != null && 
        resource.data.mentorId == request.auth.uid;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && 
        resource.data.mentorId == request.auth.uid;
    }
    
    match /cvVerifications/{cvVerificationId} {
      allow read: if request.auth != null && 
        resource.data.mentorId == request.auth.uid;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && 
        resource.data.mentorId == request.auth.uid;
    }
  }
}
